# Origin of the FanBoard backend. Server-side only: next.config.js rewrites
# /api to it, so the browser only ever talks to this app's own origin.
#
# Same-origin is required, not preferred. The session cookie is httpOnly and
# SameSite=Lax, so a browser will not send it cross-site — calling the backend
# directly would 401 every authenticated request.
BACKEND_ORIGIN=https://fanboard-backend-production.up.railway.app
