{
  "name": "@fanboard/backend",
  "version": "0.1.0",
  "private": true,
  "description": "FanBoard API and job host (Next.js App Router)",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start",
    "type-check": "tsc --noEmit",
    "lint": "eslint . --ext .ts,.tsx --max-warnings 0",
    "test": "vitest run --config vitest.config.mts",
    "test:watch": "vitest --config vitest.config.mts",
    "db:apply": "psql \"$DATABASE_URL\" -f schema.sql"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "next": "^16.3.1",
    "pg": "^8.23.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "redis": "^6.2.1",
    "zod": "^4.4.3",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10",
    "@types/ws": "^8.5.13"
  }
}
