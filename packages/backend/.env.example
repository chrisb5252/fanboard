# Copy to `.env.local` (git-ignored) and fill in real values.
#
#     cp packages/backend/.env.example packages/backend/.env.local

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fanboard
REDIS_URL=redis://localhost:6379
THESPORTSDB_API_KEY=YOUR_KEY_HERE
NEXT_PUBLIC_API_URL=http://localhost:3000

# Optional. Set to "false" to boot the server without background workers
# (integration tests, a one-off container, a read-only replica).
# Read straight from process.env at startup rather than through the validated
# env schema, so a missing THESPORTSDB_API_KEY cannot stop the server booting.
# WORKERS_ENABLED=true

# Optional. One of: debug | info | warn | error | silent. Defaults to info.
# LOG_LEVEL=info

# Cookies are Secure by default. Set to "false" ONLY to serve the patron app
# over plain http on a venue LAN -- a Secure cookie is never sent over http, so
# leaving this at the default there breaks login silently.
# COOKIE_SECURE=true

# REQUIRED IN PRODUCTION, and it must be a real process env var, not a value in
# this file. `next start` installs its own SIGTERM handler before the app loads
# and exits the process from it, which cuts off the worker drain. Setting this
# makes Next install nothing and hands shutdown to worker-scheduler.ts.
# NEXT_MANUAL_SIG_HANDLE=1
